# Use the public project token from PostHog project settings, never a personal API key.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=

# US Cloud: https://us.i.posthog.com
# EU Cloud: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# PixelWall Pro: server-only variables. Never prefix these with NEXT_PUBLIC_.
# Use test keys and a test one-time USD $19 price first.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
PIXELWALL_SITE_URL=http://localhost:3000
# Optional comma-separated HTTPS storefront aliases; never use wildcards.
PIXELWALL_ADDITIONAL_ORIGINS=
# Generate a random value of at least 32 characters. Keep it stable and backed up:
# changing this value invalidates existing Pro recovery codes.
PIXELWALL_LICENSE_SECRET=
# Optional notification endpoint: /api/billing/webhook
# Purchase checks work directly against Stripe even without webhooks.
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false

# Optional search-console verification tokens (public values, read at build time).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

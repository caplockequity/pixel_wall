{
  "schemaVersion": 2,
  "contract": {"documentFormat": 4, "commandContractVersion": "1.0", "capabilities": "pixelwall_capabilities", "commandSchemas": "pixelwall_command_schema", "applyCommandLimit": 2000, "batchCommandLimit": 1024},
  "product": "PixelWall",
  "officialSite": "https://www.pixelwall.dev",
  "guide": "https://www.pixelwall.dev/guides/ai-agents",
  "sceneWaterGuide": "https://www.pixelwall.dev/guides/isometric-water",
  "isometricPixelArtGuide": "https://www.pixelwall.dev/guides/isometric-pixel-art",
  "interfaces": {
    "cli": {
      "available": true,
      "runtime": "Node.js >=22.13.0",
      "download": "https://www.pixelwall.dev/downloads/pixelwall-cli.zip",
      "documentation": "https://www.pixelwall.dev/guides/command-line"
    },
    "browserCommandApi": {
      "available": true,
      "global": "window.pixelwall",
      "version": 1,
      "documentation": "https://www.pixelwall.dev/guides/command-api",
      "limits": {"projectImportBytes": 16777216, "projectContainerBytes": 67108864},
      "operationPolling": {
        "start": "apply({commands, wait:false})",
        "poll": "operation(operationId)",
        "recover": "inspect().latestOperation",
        "retainedOperations": 64,
        "scope": "current editor page lifetime"
      },
      "exportHandoff": {
        "generateOnly": "export({format, download:false})",
        "latest": "exportResult()",
        "urls": "page-local object URLs until next export, dismissal, or editor unmount",
        "browserDownloadCompletion": "unobservable"
      }
    },
    "lua": {
      "available": true,
      "version": "5.4",
      "sandboxed": true,
      "documentation": "https://www.pixelwall.dev/guides/scripting"
    },
    "jsonCommandBatches": {
      "available": true,
      "documentation": "https://www.pixelwall.dev/guides/scripting"
    },
    "computerControl": {
      "availableWhenProvidedByHost": true,
      "surfaces": [
        "browser",
        "desktop"
      ]
    },
    "browserModelContextRegistration": {
      "availableWhenProvidedByHost": true
    },
    "localMcp": {
      "available": true,
      "documentation": "https://www.pixelwall.dev/guides/desktop-mcp",
      "requires": ["PixelWall desktop window", "Node.js >=22.13.0", "downloaded CLI bundle", "Help-menu local agent opt-in", "user-selected export folder"],
      "transport": "authenticated local stdio/loopback",
      "scope": "one controller for the open desktop editor window",
      "remoteAccess": false,
      "artifactLimits": {"retentionHours": 24, "maxFiles": 64, "maxTotalBytes": 134217728, "maxFileBytes": 67108864, "maxReadChunkBytes": 1048576},
      "tools": ["pixelwall_inspect", "pixelwall_commands", "pixelwall_command_schema", "pixelwall_capabilities", "pixelwall_apply", "pixelwall_operation", "pixelwall_new_document", "pixelwall_preview", "pixelwall_capture_preview", "pixelwall_save", "pixelwall_export", "pixelwall_export_plan", "pixelwall_export_result", "pixelwall_undo", "pixelwall_redo", "pixelwall_projects", "pixelwall_open_project", "pixelwall_open_temporary", "pixelwall_temporary_projects", "pixelwall_open_temporary_project", "pixelwall_persistence", "pixelwall_checkpoint", "pixelwall_validate", "pixelwall_cancel", "pixelwall_artifacts", "pixelwall_read_artifact", "pixelwall_remove_artifact", "pixelwall_download_artifact", "pixelwall_save_artifact", "pixelwall_selection", "pixelwall_animation_review", "pixelwall_receipt", "pixelwall_wait_operation"]
    },
    "standaloneMcpServer": {
      "available": false,
      "note": "The supported MCP connection is the opt-in local desktop launcher; there is no hosted or remote MCP service."
    },
    "publicRestEditingApi": {
      "available": false
    },
    "javascriptSdk": {
      "available": false
    },
    "pythonSdk": {
      "available": false
    },
    "universalAgentProtocol": {
      "available": false
    }
  },
  "examples": {
    "animatedNinjaPandaCommands": "https://www.pixelwall.dev/examples/agent-ninja-panda-commands.json",
    "isometricWaterCommands": "https://www.pixelwall.dev/examples/isometric-water.json",
    "isometricShapeCommands": "https://www.pixelwall.dev/examples/isometric-shapes.json",
    "animatedNinjaPandaProject": "https://www.pixelwall.dev/examples/agent-ninja-panda.pixelwall",
    "renderedNinjaPandaPng": "https://www.pixelwall.dev/examples/agent-ninja-panda.png",
    "riverCommands": "https://www.pixelwall.dev/examples/agent-river-commands.json",
    "riverLuaDetail": "https://www.pixelwall.dev/examples/agent-river-detail.lua",
    "sceneComponentsCommands": "https://www.pixelwall.dev/examples/scene-components-commands.json",
    "sceneComponentsProject": "https://www.pixelwall.dev/examples/scene-components-woodland.pixelwall",
    "sceneComponentsPreview": "https://www.pixelwall.dev/examples/scene-components-woodland.png",
    "willowmereGuide": "https://www.pixelwall.dev/guides/willowmere",
    "willowmerePackage": "https://www.pixelwall.dev/examples/willowmere/releases/art-direction-20261027-v1/Willowmere-art-direction-guide.zip"
  },
  "largeEditGuide": "https://www.pixelwall.dev/guides/large-agent-edits"
}

{
  "name": "pixelwall-desktop",
  "version": "0.2.1",
  "description": "PixelWall local desktop studio",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "40.10.6",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ai.caplock.pixelwall",
    "productName": "PixelWall",
    "files": [
      "main.mjs",
      "update-checker.mjs",
      "app/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.graphics-design",
      "icon": "../public/pixelwall-icon-512.png",
      "artifactName": "PixelWall-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "notarize": false
    },
    "win": {
      "target": "nsis",
      "icon": "../public/pixelwall-icon-512.png",
      "artifactName": "PixelWall-${version}-windows-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "category": "Graphics",
      "icon": "../public/pixelwall-icon-512.png",
      "artifactName": "PixelWall-${version}-linux-${arch}.${ext}"
    },
    "directories": {
      "output": "release"
    }
  },
  "author": "Caplock"
}
